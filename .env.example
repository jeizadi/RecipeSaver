# Local development defaults. These values are for the Docker database only.
DATABASE_URL="postgresql://recipesaver:recipesaver@localhost:5433/recipesaver?schema=public"
DIRECT_URL="postgresql://recipesaver:recipesaver@localhost:5433/recipesaver?schema=public"

# Keep authentication disabled while developing the public/shared prototype.
# Set to true when testing login, household access, or protected routes.
AUTH_ENABLED="false"
